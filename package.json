{
  "name": "forgeflow-intelligence",
  "version": "0.1.0",
  "private": true,
  "description": "Durable, provenance-first company intelligence workflows.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev:api": "set -a; [ -f .env ] && . ./.env; set +a; npm run dev --workspace=@forgeflow/api",
    "dev:web": "set -a; [ -f .env ] && . ./.env; set +a; PORT=3000 npm run dev --workspace=@forgeflow/web",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs --follow",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "playwright test",
    "release:check-migrations": "node scripts/check-migration-compatibility.mjs",
    "release:check-containers": "node scripts/verify-container-contract.mjs",
    "format:check": "prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
