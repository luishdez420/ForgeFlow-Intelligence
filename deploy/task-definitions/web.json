{
  "family": "forgeflow-__API_ENV__-web",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "__TASK_EXECUTION_ROLE_ARN__",
  "taskRoleArn": "__TASK_ROLE_ARN__",
  "containerDefinitions": [
    {
      "name": "web",
      "image": "__IMAGE_URI__",
      "essential": true,
      "portMappings": [{ "containerPort": 3000, "protocol": "tcp" }],
      "environment": [
        { "name": "FORGEFLOW_API_URL", "value": "http://api:3001" },
        { "name": "APP_ORIGIN", "value": "__WEB_APP_ORIGIN__" },
        {
          "name": "GOOGLE_WORKSPACE_DOMAIN",
          "value": "__GOOGLE_WORKSPACE_DOMAIN__"
        },
        { "name": "AUTH_TRUST_HOST", "value": "true" }
      ],
      "secrets": [
        {
          "name": "AUTH_SECRET",
          "valueFrom": "__WEB_AUTH_SECRET_ARN__"
        },
        {
          "name": "AUTH_GOOGLE_ID",
          "valueFrom": "__GOOGLE_OAUTH_SECRET_ARN__:AUTH_GOOGLE_ID::"
        },
        {
          "name": "AUTH_GOOGLE_SECRET",
          "valueFrom": "__GOOGLE_OAUTH_SECRET_ARN__:AUTH_GOOGLE_SECRET::"
        },
        {
          "name": "FORGEFLOW_INTERNAL_API_SECRET",
          "valueFrom": "__INTERNAL_API_SECRET_ARN__"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/forgeflow/__API_ENV__/web",
          "awslogs-region": "__AWS_REGION__",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "node -e \"fetch('http://127.0.0.1:3000/').then(response => process.exit(response.ok ? 0 : 1)).catch(() => process.exit(1))\""
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 20
      }
    }
  ]
}
