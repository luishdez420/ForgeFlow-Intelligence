{
  "family": "forgeflow-API_ENV-web",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "TASK_EXECUTION_ROLE_ARN",
  "taskRoleArn": "TASK_ROLE_ARN",
  "containerDefinitions": [
    {
      "name": "web",
      "image": "IMAGE_URI",
      "essential": true,
      "portMappings": [{ "containerPort": 3000, "protocol": "tcp" }],
      "environment": [
        { "name": "FORGEFLOW_API_URL", "value": "http://api:3001" },
        { "name": "APP_ORIGIN", "value": "WEB_APP_ORIGIN" },
        {
          "name": "GOOGLE_WORKSPACE_DOMAIN",
          "value": "GOOGLE_WORKSPACE_DOMAIN"
        },
        { "name": "AUTH_TRUST_HOST", "value": "true" }
      ],
      "secrets": [
        {
          "name": "AUTH_SECRET",
          "valueFrom": "WEB_AUTH_SECRET_ARN"
        },
        {
          "name": "AUTH_GOOGLE_ID",
          "valueFrom": "GOOGLE_OAUTH_SECRET_ARN:AUTH_GOOGLE_ID::"
        },
        {
          "name": "AUTH_GOOGLE_SECRET",
          "valueFrom": "GOOGLE_OAUTH_SECRET_ARN:AUTH_GOOGLE_SECRET::"
        },
        {
          "name": "FORGEFLOW_INTERNAL_API_SECRET",
          "valueFrom": "INTERNAL_API_SECRET_ARN"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/forgeflow/API_ENV/web",
          "awslogs-region": "AWS_REGION",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "node -e \"fetch('http://127.0.0.1:3000/').then(response => process.exit(response.ok ? 0 : 1)).catch(() => process.exit(1))\""
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 20
      }
    }
  ]
}
