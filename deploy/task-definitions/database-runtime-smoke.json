{
  "family": "forgeflow-__API_ENV__-database-runtime-smoke",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "__TASK_EXECUTION_ROLE_ARN__",
  "taskRoleArn": "__TASK_ROLE_ARN__",
  "containerDefinitions": [
    {
      "name": "database-runtime-smoke",
      "image": "__IMAGE_URI__",
      "essential": true,
      "command": [
        "./node_modules/.bin/tsx",
        "apps/api/src/database-runtime-smoke.ts"
      ],
      "secrets": [
        {
          "name": "DATABASE_URL",
          "valueFrom": "__DATABASE_RUNTIME_SECRET_ARN__"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/forgeflow/__API_ENV__/database-role-bootstrap",
          "awslogs-region": "__AWS_REGION__",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
