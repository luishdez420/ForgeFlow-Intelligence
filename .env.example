# Copy to .env for local development. Never commit real provider or model keys.
DATABASE_URL=postgresql://forgeflow:forgeflow@localhost:15432/forgeflow
REDIS_URL=redis://localhost:16379/0
PORT=3001
FORGEFLOW_API_URL=http://localhost:3001
# Generate a unique 32+ byte value and use the same value for the API and web.
FORGEFLOW_INTERNAL_API_SECRET=
# Required outside local development; used to reject cross-site browser mutations.
APP_ORIGIN=http://localhost:3000

# Google Workspace SSO. Keep actual values in local secrets or AWS Secrets Manager.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
GOOGLE_WORKSPACE_DOMAIN=
# Local development only. Ignored outside NODE_ENV=development.
GOOGLE_ALLOWED_TEST_EMAIL=

# Deferred until the market-provider adapter issue.
MARKET_DATA_API_KEY=
OPENAI_API_KEY=

# Opt-in SEC EDGAR live smoke check. Keep disabled in normal development and CI.
SEC_EDGAR_LIVE_ENABLED=false
SEC_EDGAR_USER_AGENT=
